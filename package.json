{
  "name": "pulseops-ai",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "packageManager": "pnpm@10.20.0",
  "pnpm": {
    "overrides": {
      "rollup": "npm:@rollup/wasm-node@4.68.0",
      "esbuild": "npm:esbuild-wasm@0.28.2"
    }
  },
  "scripts": {
    "dev": "pnpm --parallel --filter @pulseops/api --filter @pulseops/web dev",
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "lint": "eslint . --max-warnings=0",
    "test": "vitest run --configLoader runner",
    "test:e2e": "playwright test",
    "db:migrate": "pnpm --filter @pulseops/api db:migrate",
    "db:seed": "pnpm --filter @pulseops/api db:seed",
    "eval": "pnpm --filter @pulseops/api eval"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@playwright/test": "^1.56.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.0",
    "@types/node": "^24.10.0",
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.2",
    "eslint": "^9.39.1",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.4.24",
    "globals": "^16.5.0",
    "jsdom": "^27.2.0",
    "prettier": "^3.6.2",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.46.4",
    "vitest": "^4.0.8"
  }
}
